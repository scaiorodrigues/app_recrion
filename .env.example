# Credenciais do Firebase.
# Copie este arquivo para .env e preencha com os dados do seu projeto
# (Console do Firebase → Configurações do projeto → Seus apps).
#
# Enquanto estes valores estiverem vazios, o app roda em MODO DEMONSTRAÇÃO:
# tudo funciona localmente, mas nada é salvo no servidor.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# ID do cliente OAuth Web do Google (para o login com Google no Android).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
